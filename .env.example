# ================================================================
# DSPACE ELECTRONICS - ENVIRONMENT CONFIGURATION
# ================================================================

# Supabase / PostgreSQL Direct Database URL for Drizzle ORM
# (Find this in Supabase Project Settings -> Database -> Connection String -> URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Client Public Keys
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Razorpay Test Key ID (Optional - app will run in test simulation mode if omitted)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyHere"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
