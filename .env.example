# ================================================================
# DSPACE ELECTRONICS - ENVIRONMENT CONFIGURATION (.env.local)
# ================================================================

# 1. Supabase / PostgreSQL Direct Database URL for Drizzle ORM
# (Find this in Supabase Project Settings -> Database -> Connection String -> URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Client Public Keys
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# 2. Razorpay Payment Gateway Credentials
# For Test Mode: starts with "rzp_test_..."
# For Live Mode: toggle to "Live Mode" on Razorpay Dashboard -> API Keys -> starts with "rzp_live_..."
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 3. Borzo (formerly WeFast) Business Delivery API (v1.8 India)
# Get your token at https://borzodelivery.com/in/business-api (API Integration tab)
BORZO_AUTH_TOKEN="your_borzo_business_api_token"
BORZO_API_URL="https://robotapi-in.borzodelivery.com/api/business/1.8"
# For India sandbox/test environment: "https://robotapitest-in.borzodelivery.com/api/business/1.8"
